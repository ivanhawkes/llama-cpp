#!/usr/bin/env bash
# perf-watch — one-shot, read-only performance snapshot of the running llama-server.
#
# Sources:
#   - http://localhost:$PORT/metrics   (llamacpp:* counters/gauges)
#   - $LLAMA_SERVER_LOG               per-request "prompt eval time" / "eval time" lines
#   - nvidia-smi                      VRAM + utilization
#
# Prints a summary to stdout and appends the same block to logs/perf-watch.log.
# No args. Env overrides: PORT (default 8080), LLAMA_SERVER_LOG (default
# /tmp/llama-server.log), PERF_WATCH_LOG (default <repo>/logs/perf-watch.log).
#
# Notes:
#   - This llama.cpp build exposes no TTFT metric in /metrics; TTFT is
#     approximated by the per-request "prompt eval time" (prefill) from the log.
#   - The server log is truncated on every start, so all timing lines in it
#     belong to the current session — no filtering needed.

set -euo pipefail

PORT="${PORT:-8080}"
LOG="${LLAMA_SERVER_LOG:-/tmp/llama-server.log}"
ROOT="$(cd -- "$(dirname -- "$0")/.." && pwd)"
OUT="${PERF_WATCH_LOG:-$ROOT/logs/perf-watch.log}"

metrics_url="http://localhost:${PORT}/metrics"
if ! metrics="$(curl -sf --max-time 10 "$metrics_url")"; then
  echo "perf-watch: cannot reach $metrics_url (is the server running?)" >&2
  exit 1
fi

mval() { printf '%s\n' "$metrics" | awk -v m="$1" '$1 == m { print $2; exit }'; }

ptok="$(mval llamacpp:prompt_tokens_total)";            ptok="${ptok:-0}"
psec="$(mval llamacpp:prompt_seconds_total)";           psec="${psec:-0}"
gtok="$(mval llamacpp:tokens_predicted_total)";         gtok="${gtok:-0}"
gsec="$(mval llamacpp:tokens_predicted_seconds_total)"; gsec="${gsec:-0}"
drafts="$(mval llamacpp:spec_decode_num_draft_tokens_total)";   drafts="${drafts:-0}"
accept="$(mval llamacpp:spec_decode_num_accepted_tokens_total)"; accept="${accept:-0}"
ndrafts="$(mval llamacpp:spec_decode_num_drafts_total)";        ndrafts="${ndrafts:-0}"
busy="$(mval llamacpp:requests_processing)";           busy="${busy:-?}"
deferred="$(mval llamacpp:requests_deferred)";         deferred="${deferred:-?}"

pspeed="$(awk -v a="$ptok" -v b="$psec" 'BEGIN { if (b > 0) printf "%.1f", a / b; else print "n/a" }')"
gspeed="$(awk -v a="$gtok" -v b="$gsec" 'BEGIN { if (b > 0) printf "%.1f", a / b; else print "n/a" }')"
mtp="$(awk -v d="$drafts" -v a="$accept" -v n="$ndrafts" \
  'BEGIN { if (d > 0 && n > 0) printf "accept %.2f, mean len %.1f", a / d, d / n; else print "n/a" }')"

if [ -r "$LOG" ]; then
  per_req="$(awk '
    function tps(ms, tok) { return (ms > 0) ? tok * 1000 / ms : 0 }
    /prompt eval time/ {
      l = $0; sub(/.*prompt eval time = +/, "", l); sub(/ .*/, "", l); ms = l + 0
      l = $0; sub(/.*\/ +/, "", l); sub(/ tokens.*/, "", l); tok = l + 0
      n++; sum += tps(ms, tok)
      if (n == 1 || tps(ms, tok) < pmin) pmin = tps(ms, tok)
      if (n == 1 || tps(ms, tok) > pmax) pmax = tps(ms, tok)
      ttft += ms
      if (n == 1 || ms < tmin) tmin = ms
      if (n == 1 || ms > tmax) tmax = ms
    }
    /eval time/ && !/prompt eval time/ {
      l = $0; sub(/.*eval time = +/, "", l); sub(/ .*/, "", l); ms = l + 0
      l = $0; sub(/.*\/ +/, "", l); sub(/ tokens.*/, "", l); tok = l + 0
      m++; gsum += tps(ms, tok)
      if (m == 1 || tps(ms, tok) < gmin) gmin = tps(ms, tok)
      if (m == 1 || tps(ms, tok) > gmax) gmax = tps(ms, tok)
    }
    END {
      if (n > 0) printf "prompt: %d reqs | TTFT %.0f-%.0f ms (avg %.0f) | %.0f-%.0f t/s (avg %.1f)\n", \
        n, tmin, tmax, ttft / n, pmin, pmax, sum / n
      else printf "prompt: no timing lines in log\n"
      if (m > 0) printf "gen:    %d reqs | %.1f-%.1f t/s (avg %.1f)\n", m, gmin, gmax, gsum / m
      else printf "gen:    no timing lines in log\n"
    }' "$LOG")"
else
  per_req="prompt: log $LOG not found
gen:    log $LOG not found"
fi

vram="$(nvidia-smi --query-gpu=index,name,memory.used,memory.free,utilization.gpu \
  --format=csv,noheader 2>/dev/null | awk -F', *' \
  '{ printf "idx%s %s: %s used / %s free (%s util)\n", $1, $2, $3, $4, $5 }')"
[ -n "$vram" ] || vram="nvidia-smi unavailable"

ts="$(date '+%Y-%m-%dT%H:%M:%S%z')"
block="$(cat <<EOF
=== ${ts} perf-watch ===
requests: processing=${busy} deferred=${deferred}
session totals: prompt ${pspeed} t/s (${ptok} tok) | gen ${gspeed} t/s (${gtok} tok)
MTP: ${mtp}
${per_req}
VRAM:
${vram}
EOF
)"

mkdir -p "$(dirname -- "$OUT")"
printf '%s\n' "$block" >> "$OUT"
printf '%s\n' "$block"
